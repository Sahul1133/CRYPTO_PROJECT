{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "backend": {
      "root": "backend",
      "runtime": "python",
      "entrypoint": "app/main.py",
      "functions": {
        "app/main.py": {
          "excludeFiles": "{data/raw/**,data/processed/**,app/ml/**,test_*.py,create_dataset.py,train_models.py}"
        }
      }
    },
    "frontend": {
      "root": "frontend",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
